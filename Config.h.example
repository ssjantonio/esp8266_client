#pragma once
/* Contador interno de build/protocolo (Modbus h3, TCP). No es 1.1.0 semver; sube +1 por release. ≥259 = map v2. */
#define FIRMWARE_VERSION 260
/* Obsoleto: el sketch usa LittleFSConfig + format explícito en mountLittleFs() */

#ifndef STASSID
#define WFSTA 1
#define WFAP 0
#define BAUD_RATE 9600
#define IP_DYNAMIC 0
#define IP_STATIC 1
#define USE_TTL 1
#define STASSID "TU_SSID"
#define STAPSK "TU_PASSWORD_WIFI"
/* Placeholder: si identifier sigue igual tras resetConfig, se sustituye por HQ_IOT_<chipId> en primer arranque. */
#define ID_PREFIX "HQ_IOT_"
/* Contraseña POST /ap-mode y PSK del AP (WPA2: si tiene <8 chars se usa psk+\"00\"). */
#define AP_PROVISIONING_PASSWORD "16794300"
#define HOSTNAME "BASC_01_EJEMPLO"
#define IDENTIFIER "BASC_01_EJEMPLO"
#define USERTOKEN "1234567890ABCDE"
#define ADMINTOKEN "ABCDE0123456789"
#define DECIMAL_PLACES 2
#define DECIMAL_CHARACTER .
#define DECIMAL_ASCII 46
#define EEPROM_SIZE 12
/* Ciclo WiFi en modo Station: intentos STA → AP recuperación → STA */
#ifndef WIFI_STA_CONNECT_ATTEMPTS
#define WIFI_STA_CONNECT_ATTEMPTS 5
#endif
#ifndef WIFI_STA_ATTEMPT_TIMEOUT_SEC
#define WIFI_STA_ATTEMPT_TIMEOUT_SEC 12
#endif
#ifndef WIFI_AP_RECOVERY_MS
#define WIFI_AP_RECOVERY_MS 60000UL
#endif
#endif

struct Config {
  short firmware_version = 260;
  short wifi_mode = WFAP;
  char host_name[16];
  char identifier[16];
  char user_token[16];
  char admin_token[16];
  short ip_type = IP_DYNAMIC;
  char ssid[32];
  char password[24];
  char ip_address[16];
  char gateway[16];
  char subnet[16];
  char primary_dns[16];
  char secondary_dns[16];
  char server_host[32];
  short server_port = 0;
  short tcp_client_enabled = 1;
  short modbus_server_enabled = 1;
  short modbus_port = 502;
  float m_value = 1;
  float b_value = 0;
  float filter_alpha = 0.01;
  float umbral_error = 0.1;
  float d_value = 0.1;
  float t_value = 4;
  short uart_time_out = 5;
  short avg_count = 4;
  short sensor_type = 0;
  short sensor_id = 1;
  short group_id = 1;
};