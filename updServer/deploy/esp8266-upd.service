[Unit]
Description=ESP8266 OTA update server (Node)
After=network.target

[Service]
Type=simple
User=antonio
WorkingDirectory=/home/antonio/esp8266-upd-server/updServer
Environment=NODE_ENV=production
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target